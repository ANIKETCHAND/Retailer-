# ========================================================
# RetailVision Environment Configuration Example
# Copy this file to .env and modify as needed for deployment.
# ========================================================

APP_NAME=RetailVision
APP_ENV=development
APP_PORT=8501
API_PORT=8001
API_HOST=0.0.0.0

# UI Settings
DEFAULT_THEME=dark

# Logging
LOG_LEVEL=INFO

# Forecasting Parameters
FORECAST_DEFAULT_HORIZON=30
FORECAST_MIN_DAYS_REQUIRED=20
FORECAST_TEST_RATIO=0.15
FORECAST_RIDGE_ALPHA=1.0

# Safety Limits
MAX_UPLOAD_SIZE_MB=50
