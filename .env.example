# ========================================================
# RetailVision Environment Configuration Example
# Copy this file to .env and modify as needed for deployment.
# ========================================================

APP_NAME=RetailVision
APP_ENV=development
APP_PORT=8501
API_PORT=8001
API_HOST=0.0.0.0

# UI Settings
DEFAULT_THEME=dark

# Logging
LOG_LEVEL=INFO

# Forecasting Parameters
FORECAST_DEFAULT_HORIZON=30
FORECAST_MIN_DAYS_REQUIRED=20
FORECAST_TEST_RATIO=0.15
FORECAST_RIDGE_ALPHA=1.0

# ========================================================
# Supabase PostgreSQL Configuration
# ========================================================
# For Python backend / SQLAlchemy (Direct or Supavisor pooled connection):
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# For Frontend React client (@supabase/supabase-js):
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Safety Limits
MAX_UPLOAD_SIZE_MB=50
