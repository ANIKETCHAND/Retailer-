# ========================================================
# RetailVision Environment Configuration Example
# Copy this file to .env and modify as needed for deployment.
# ========================================================

APP_NAME=RetailVision
APP_ENV=development
APP_PORT=8501
API_PORT=8001
APP_HOST=0.0.0.0
API_HOST=0.0.0.0

# ========================================================
# Supabase Central Cloud Platform Configuration
# ========================================================
# Your Supabase Project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# Supabase Anonymous Public Key (Safe for client headers)
SUPABASE_ANON_KEY=

# Supabase Service Role Secret Key (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL Connection URL (via Supabase Connection Pooling / Direct)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# When left blank, RetailVision automatically falls back to isolated local SQLite for development/testing.
DATABASE_URL=

# Supabase Storage Buckets
SUPABASE_STORAGE_BUCKET_DATASETS=retail-datasets
SUPABASE_STORAGE_BUCKET_REPORTS=retail-reports

# Authentication & Security
JWT_SECRET=retailvision-jwt-production-secret-2026

# UI Settings
DEFAULT_THEME=dark

# Logging
LOG_LEVEL=INFO

# Forecasting Parameters
FORECAST_DEFAULT_HORIZON=30
FORECAST_MIN_DAYS_REQUIRED=20
FORECAST_TEST_RATIO=0.15
FORECAST_RIDGE_ALPHA=1.0

# Safety Limits
MAX_UPLOAD_SIZE_MB=50
